From fcbbd8e402dd23c0d9860349e63ced90f181c209 Mon Sep 17 00:00:00 2001
From: Jeric Dante <computernerder@gmail.com>
Date: Sun, 18 Oct 2026 15:06:59 -0400
Subject: [PATCH] display: port Prusa MINI ST7789V support

---
 klippy/extras/bus.py                          |   4 +-
 klippy/extras/display/display.py              |  12 +-
 klippy/extras/display/jeric_shark_240x100.png | Bin 0 -> 20875 bytes
 klippy/extras/display/logo.py                 |  20 +
 klippy/extras/display/st7789v.py              | 403 ++++++++++++++++++
 5 files changed, 434 insertions(+), 5 deletions(-)
 create mode 100644 klippy/extras/display/jeric_shark_240x100.png
 create mode 100644 klippy/extras/display/logo.py
 create mode 100644 klippy/extras/display/st7789v.py

diff --git a/klippy/extras/bus.py b/klippy/extras/bus.py
index b04fbe76..98b7b3ae 100644
--- a/klippy/extras/bus.py
+++ b/klippy/extras/bus.py
@@ -119,13 +119,13 @@ class MCU_SPI:
 # Helper to setup an spi bus from settings in a config section
 def MCU_SPI_from_config(config, mode, pin_option="cs_pin",
                         default_speed=100000, share_type=None,
-                        cs_active_high=False):
+                        cs_active_high=False, use_cs_pin=True):
     # Determine pin from config
     ppins = config.get_printer().lookup_object("pins")
     cs_pin = config.get(pin_option)
     cs_pin_params = ppins.lookup_pin(cs_pin, share_type=share_type)
     pin = cs_pin_params['pin']
-    if pin == 'None':
+    if pin == 'None' or not use_cs_pin:
         ppins.reset_pin_sharing(cs_pin_params)
         pin = None
     # Load bus parameters
diff --git a/klippy/extras/display/display.py b/klippy/extras/display/display.py
index cc33bc15..5abd3519 100644
--- a/klippy/extras/display/display.py
+++ b/klippy/extras/display/display.py
@@ -6,19 +6,23 @@
 #
 # This file may be distributed under the terms of the GNU GPLv3 license.
 import logging, os, ast
-from . import aip31068_spi, hd44780, hd44780_spi, st7920, uc1701, menu
+from . import (aip31068_spi, hd44780, hd44780_spi, st7920, st7789v,
+               uc1701, menu)
 
 # Normal time between each screen redraw
 REDRAW_TIME = 0.500
 # Minimum time between screen redraws
 REDRAW_MIN_TIME = 0.100
+# A color display may split a large framebuffer update over several flushes.
+INCOMPLETE_FLUSH_MIN_TIME = 0.075
 
 LCD_chips = {
     'st7920': st7920.ST7920, 'emulated_st7920': st7920.EmulatedST7920,
     'hd44780': hd44780.HD44780, 'uc1701': uc1701.UC1701,
     'ssd1306': uc1701.SSD1306, 'sh1106': uc1701.SH1106,
     'hd44780_spi': hd44780_spi.hd44780_spi,
-    'aip31068_spi':aip31068_spi.aip31068_spi
+    'aip31068_spi':aip31068_spi.aip31068_spi,
+    'st7789v': st7789v.ST7789V
 }
 
 # Storage of [display_template my_template] config sections
@@ -235,7 +239,9 @@ class PrinterLCD:
             self.show_data_group.show(self, self.display_templates, eventtime)
         except:
             logging.exception("Error during display screen update")
-        self.lcd_chip.flush()
+        flush_complete = self.lcd_chip.flush()
+        if flush_complete is False:
+            return eventtime + INCOMPLETE_FLUSH_MIN_TIME
         if self.redraw_request_pending:
             return self.redraw_time
         return eventtime + REDRAW_TIME
