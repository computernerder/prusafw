diff --git a/klippy/extras/display/logo.py b/klippy/extras/display/logo.py
new file mode 100644
index 00000000..9a71286e
--- /dev/null
+++ b/klippy/extras/display/logo.py
@@ -0,0 +1,20 @@
+# Jeric MINI native-resolution display header.
+#
+# This file may be distributed under the terms of the GNU GPLv3 license.
+import os
+
+from PIL import Image
+
+LOGO_IMAGE = None
+
+
+def make_logo(width):
+    global LOGO_IMAGE
+    if LOGO_IMAGE is None:
+        asset_path = os.path.join(os.path.dirname(__file__),
+                                  'jeric_shark_240x100.png')
+        LOGO_IMAGE = Image.open(asset_path).convert('RGB')
+    if LOGO_IMAGE.width == width:
+        return LOGO_IMAGE.copy()
+    height = round(LOGO_IMAGE.height * width / LOGO_IMAGE.width)
+    return LOGO_IMAGE.resize((width, height), Image.Resampling.LANCZOS)
